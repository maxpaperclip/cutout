{
  "name": "friendshaped",
  "version": "1.40.0",
  "private": true,
  "description": "In-browser vector and bitmap graphics editor for classroom use. Builds to a single self-contained HTML file.",
  "scripts": {
    "build": "node build.js",
    "build:min": "node build.js --minify",
    "dev": "node build.js --watch",
    "serve": "node build.js && npx --yes serve dist/site",
    "release": "node build.js && node scripts/copy-to-root.js",
    "test": "node --test tests-unit/*.test.js",
    "verify:fonts": "node scripts/verify-fonts.js"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "jsdom-for-tests": "npm:jsdom@26.1.0",
    "opentype.js": "1.3.4",
    "paper": "0.12.18"
  }
}
